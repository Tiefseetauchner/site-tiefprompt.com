<meta property="og:title" content="{{ lua: local c = (nav and nav.current) or {}; local fm = c.front_matter or {}; local base = fm.og_title or (c.path ~= 'index.html' and c.title); return (base and (tostring(base) .. ' || TiefPrompt')) or 'TiefPrompt || Free Open Source Teleprompter' }}"/>
<meta property="og:description" content="{{ lua: local fm = (nav and nav.current and nav.current.front_matter) or {}; return fm.description or 'A clean, open source teleprompter for Android and iOS. Scripts, fonts, countdown timer and more.' }}"/>
<meta property="og:image" content="{{ lua: local og = dofile('oglib.lua'); return og.resolve(nav and nav.current, meta and meta.base_path, dofile('ogconfig.lua')) }}"/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta property="og:image:type" content="image/jpeg"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta property="og:type" content="website"/>
<meta name="description" content="{{ lua: local fm = (nav and nav.current and nav.current.front_matter) or {}; return fm.description or 'A clean, open source teleprompter for Android and iOS. Scripts, fonts, countdown timer and more.' }}"/>
<title>{{ lua: local c = (nav and nav.current) or {}; local fm = c.front_matter or {}; local base = fm.og_title or (c.path ~= [[index.html]] and c.title); return (base and (tostring(base) .. [[ || TiefPrompt]])) or [[TiefPrompt || Free Open Source Teleprompter]] }}</title>
